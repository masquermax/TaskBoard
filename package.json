{
  "name": "taskboard-codex",
  "version": "0.9.2",
  "private": true,
  "type": "module",
  "description": "Local-first governed AI task board with externally owned pluggable Extensions.",
  "exports": {
    "./bootstrap": "./src/server/bootstrap.js",
    "./extension-api": "./src/extensions/public-api.js",
    "./extensions": "./src/extensions/index.js"
  },
  "scripts": {
    "dev": "node --watch src/server/index.js",
    "start": "node src/server/index.js",
    "test": "node --test",
    "test:module": "node scripts/run-test-layer.mjs module",
    "test:functional": "node scripts/run-test-layer.mjs functional",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/**/*.js --test-coverage-lines=94 --test-coverage-branches=74 --test-coverage-functions=87",
    "check": "node scripts/check-syntax.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=16.6.0"
  }
}
